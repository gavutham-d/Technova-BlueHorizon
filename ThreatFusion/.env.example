# ==========================================
# Threat Fusion CTI Platform
# Environment Configuration
# ==========================================

# ----------------------------
# Application
# ----------------------------
APP_NAME=Threat Fusion API
APP_ENV=development
DEBUG=True

# ----------------------------
# Backend
# ----------------------------
HOST=0.0.0.0
PORT=8000

# ----------------------------
# JWT Authentication
# ----------------------------
JWT_SECRET=change_this_to_a_secure_random_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ----------------------------
# MongoDB
# ----------------------------
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=threatfusion

# ----------------------------
# CORS
# ----------------------------
FRONTEND_URL=http://localhost:5173

# ----------------------------
# Threat Intelligence APIs
# (Optional)
# ----------------------------
ABUSEIPDB_API_KEY=
OTX_API_KEY=
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=

# ----------------------------
# Logging
# ----------------------------
LOG_LEVEL=INFO
